{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": ".tmp/tests",
    "rootDir": ".",
    "types": []
  },
  "include": [
    "src/domain/**/*.ts",
    "src/data/cloudSyncCore.ts",
    "src/data/repositories/reconcile.ts",
    "src/data/repositories/recordChanges.ts",
    "src/data/repositories/types.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts"
  ]
}
